# reaper-monitor.ReaperOSC
# 乐队排练 Web 监听专用 OSC pattern 配置
# （基于 REAPER 7 官方 Default.ReaperOSC 精简，只保留监听混音需要的动作）。
# 用法：REAPER -> Preferences -> Control/OSC/web -> Add -> OSC，Mode 选 "Configure device IP+local port"，
# 填本机 IP、发送端口（默认 9213）、接收端口（默认 9212），Pattern config 选本文件。
#
# 语义说明：
#   - 每条 ACTION 后跟的 pattern，REAPER 会发到设备做反馈，设备也可发回 REAPER 触发动作。
#   - @ 是目标通配符（轨道号 / send 序号，均从 1 起）。
#   - n 开头的值是归一化推子位 0..1（0=-inf dB，1=+12 dB）。

# 本控制面需要的轨道数与 send 数上限。send 数 = 乐队人数上限（默认 8 人足够）。
DEVICE_TRACK_COUNT 64
DEVICE_SEND_COUNT 8
DEVICE_RECEIVE_COUNT 0
DEVICE_FX_COUNT 0
DEVICE_FX_PARAM_COUNT 0
DEVICE_FX_INST_PARAM_COUNT 0
DEVICE_MARKER_COUNT 0

REAPER_TRACK_FOLLOWS REAPER
DEVICE_TRACK_FOLLOWS DEVICE
DEVICE_TRACK_BANK_FOLLOWS DEVICE
DEVICE_FX_FOLLOWS DEVICE

# 心跳与握手（桥接每 2s 发送一次，无副作用）
DEVICE_TRACK_FOLLOWS_DEVICE t/device/track/follows/device
DEVICE_TRACK_COUNT i/device/track/count t/device/track/count/@

DEVICE_EQ INSERT
DEVICE_ROTARY_CENTER 0

# 通用动作（桥接启动时发 41743 请求 REAPER 刷新所有控制面，触发轨道名反馈）
ACTION i/action t/action/@

# 轨道名（@ = 1 起轨道号）：桥接用它把配置里的"母线/源轨名称"解析成轨道号
TRACK_NAME s/track/@/name

# 监听母线：音量（归一化推子位）与静音。母线音量同时用于乐手的"总音量"，母线上再挂 ReaStream 发送。
TRACK_VOLUME n/track/volume n/track/@/volume
TRACK_MUTE b/track/mute b/track/@/mute

# 源轨 -> 监听母线 的 send 音量（归一化推子位）。REAPER 官方配置没有 send 静音，
# 所以"分轨静音"用 send volume=0 实现，恢复时回到静音前的音量。
TRACK_SEND_VOLUME n/track/send/@/volume n/track/@/send/@/volume

# send 名称反馈：桥接用它把"源轨上的某个 send"匹配到"监听母线轨道名"。
# REAPER 新建 send 时默认用目标轨道名命名；若改过名，请改回与监听母线轨道名一致。
TRACK_SEND_NAME s/track/send/@/name s/track/@/send/@/name
