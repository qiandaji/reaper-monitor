# reaper-monitor 环境配置（可选：复制为 .env 后按需修改；不提供时使用默认值）
# 监听服务器（乐手手机通过局域网访问 http://<这台电脑的IP>:61390）
RMP_HTTP_HOST=0.0.0.0
RMP_HTTP_PORT=61390
# OSC -> REAPER（本机 REAPER 控制面配置里填同样的端口）
RMP_OSC_REAPER_HOST=127.0.0.1
RMP_OSC_REAPER_PORT=9212
# OSC 反馈监听（REAPER 控制面"发送到设备的端口"填这个）
RMP_OSC_LISTEN_HOST=0.0.0.0
RMP_OSC_LISTEN_PORT=9213
# ReaStream UDP 接收端口（REAPER 里每个 MON 母线插入 ReaStream VST，destination 填这台电脑 IP:此端口）
RMP_REASTREAM_HOST=0.0.0.0
RMP_REASTREAM_PORT=58710
# 配置文件路径（相对项目根目录）
RMP_CONFIG_PATH=data/config.json
